# ──────────────────────────────────────────────────────────────────
# Supabase — pegue em https://supabase.com → seu projeto → Settings → API
# ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://nmluvutyqriaqtcknjas.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_rFc7Mnu_fUJsOKadFl4YnA_OX6YgHdx

# ──────────────────────────────────────────────────────────────────
# Site URL — usado em redirects do Stripe Connect (onboarding, refresh, return)
# Em desenvolvimento: http://localhost:3000
# Em produção: https://fauna.org (ou seu domínio)
# ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ──────────────────────────────────────────────────────────────────
# Stripe — https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY: chave secreta (server-side, NUNCA exposta ao cliente)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY: chave pública (usada no Elements/Connect frontend)
# STRIPE_WEBHOOK_SECRET: pegue ao registrar o endpoint /api/stripe/webhook
#   (Dashboard → Developers → Webhooks → "+ Add endpoint")
# ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ──────────────────────────────────────────────────────────────────
# Resend — para e-mails transacionais (confirmação de doação, verificação)
# https://resend.com/api-keys
# RESEND_FROM: remetente verificado no Resend (ex: "Fauna <oi@fauna.org>")
# Se RESEND_API_KEY estiver vazia, os e-mails são pulados silenciosamente.
# ──────────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=Fauna <onboarding@resend.dev>

# ──────────────────────────────────────────────────────────────────
# Sentry — monitoramento de erros (opcional, mas recomendado em produção)
# https://sentry.io → Projeto → Settings → Client Keys (DSN)
# Se vazio, o Sentry é desativado.
# ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=

# ──────────────────────────────────────────────────────────────────
# Upstash Redis — rate limiting em produção (opcional)
# Sem essas vars, o rate limiter usa memória local (não funciona entre
# instâncias serverless — só serve para dev). Em produção, configure
# Upstash: https://console.upstash.com/redis → Connect → REST API
# ──────────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
